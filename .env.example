# ---------------------------------------------------------------------------
# KundenRadar – Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` und fülle die Werte aus.
# Niemals echte Secrets committen.
# ---------------------------------------------------------------------------

# Supabase Projekt-URL, z. B. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase "anon" / publishable Key. Darf im Browser verwendet werden,
# ist durch Row Level Security abgesichert.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service-Role Key. NUR serverseitig verwenden.
# Wird ausschliesslich fuer administrative Aufgaben benoetigt
# (z. B. Anlegen einer Organisation beim Onboarding).
# Optional in Phase 1 – die App funktioniert auch ohne diesen Key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: User-Agent, mit dem Websites analysiert werden.
KUNDENRADAR_ANALYSIS_USER_AGENT=KundenRadarBot/1.0 (+https://kundenradar.example/bot)
